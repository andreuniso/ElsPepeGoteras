<Page x:Class="RiskClient.Pagines.SalaEspera"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:uc="clr-namespace:RiskClient.UserControls"
      mc:Ignorable="d"
      Title="SalaEspera">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="E:\M13 - PROJECTE\RiskClient\RiskClient\Imatges\sala.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Margin="200,60,200,60" Background="#AA1A1A1A" CornerRadius="16" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Nom partida -->
                    <RowDefinition Height="Auto"/>
                    <!-- Llistat jugadors -->
                    <RowDefinition Height="Auto"/>
                    <!-- Comptador -->
                    <RowDefinition Height="Auto"/>
                    <!-- Barra de càrrega -->
                    <RowDefinition Height="Auto"/>
                    <!-- Token partida -->
                    <RowDefinition Height="*"/>
                    <!-- Espai -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botons -->
                </Grid.RowDefinitions>

                <!-- Nom de la partida -->
                <TextBlock x:Name="TxtNomPartida"
                           Text="NomPartida"
                           FontSize="36" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Llistat jugadors -->
                <!-- Llistat jugadors -->
                <ScrollViewer Grid.Row="1"
              Width="850" Height="320" HorizontalAlignment="Center"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
              Background="Transparent" BorderThickness="0">
                    <WrapPanel x:Name="PlayerPanel"
               Orientation="Horizontal"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="10"
               ItemHeight="85"
               ItemWidth="400"/>
                </ScrollViewer>


                <!-- Comptador de jugadors -->
                <TextBlock x:Name="TxtComptadorJugadors"
                           Grid.Row="2"
                           Text="1 / 3"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,10"/>

                <!-- Barra de càrrega -->
                <ProgressBar x:Name="ProgressBarCarrega" Grid.Row="3" Width="400" Height="20"
                             HorizontalAlignment="Center" Margin="0,10"
                             IsIndeterminate="True"
                             Foreground="#FFA500" Background="#333"/>

                <!-- TOKEN DE PARTIDA (NOMÉS SI ÉS PRIVADA) -->
                <TextBlock x:Name="TxtTokenPartida"
                           Grid.Row="4"
                           Text="Token: ABC123"
                           FontSize="20" FontWeight="Normal"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,15,0,0"
                           Visibility="Collapsed" />

                <!-- Botons -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <!-- INICIAR -->
                    <Button x:Name="btnIniciar" Content="INICIAR" Width="200" Height="55" FontSize="22"
                            Background="#004797" Foreground="White" Cursor="Hand" Margin="10,0" Click="btnIniciar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="25" Padding="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#004797"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFA500"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- CANCEL·LAR -->
                    <Button x:Name="btnCancelar" Content="CANCEL·LAR" Width="200" Height="55" FontSize="22"
                            Background="#223B63" Foreground="White" Cursor="Hand" Margin="10,0" Click="btnCancelar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="25" Padding="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#223B63"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFA500"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
