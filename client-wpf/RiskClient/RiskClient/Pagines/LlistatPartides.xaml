<Page x:Class="RiskClient.Pagines.LlistatPartides"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:uc="clr-namespace:RiskClient.UserControls"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="LlistatPartides"
      Loaded="Page_Loaded">

    <Grid>
        <!-- Fons -->
        <Image Source="\Imatges\sala_unirse.png" Stretch="Fill"/>

        <!-- Marc fosquet -->
        <Border Margin="250,100,250,100" Background="#CC1A1A1A" CornerRadius="16" BorderBrush="#444" BorderThickness="1" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Títol -->
                <TextBlock Text="LLISTAT DE PARTIDES" Grid.Row="0" HorizontalAlignment="Center"
                           FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                <!-- Llistat de partides públiques (binding a l’ObservableCollection) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" Width="413">
                        <ListView x:Name="lvPartides"
                                  ItemsSource="{Binding Partides}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  MouseDoubleClick="lvPartides_MouseDoubleClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <uc:UCPartida partida="{Binding}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!-- Secció per unir-se a una partida privada -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="CANCEL·LAR"
                        Width="180" Height="40" FontSize="18"
                        Background="#555" Foreground="White"
                        BorderThickness="0"
                        Margin="20,0,0,0"
                        Click="btnEnrere_Click">    
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
            CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#777"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Margin="30"/>

                    <TextBox x:Name="txtTokenPrivada" Width="200" Height="40" FontSize="18"
                             Padding="10,5" Background="#333" Foreground="White" BorderBrush="#84b6f4" BorderThickness="1"
                             Margin="0,0,10,0"/>
                    <Button Content="UNIR-SE" Width="180" Height="40" FontSize="18"
                            Background="#84b6f4" Foreground="#222" BorderThickness="0"
                            Click="btnUnirPrivada_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#ff6a00"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
